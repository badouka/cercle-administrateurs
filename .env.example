# ── Base de données et Payload ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Stockage des médias (Vercel Blob). Sans ce jeton, le plugin se désactive et
# les URL des images retombent sur /api/media/file/.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# ── Services externes ────────────────────────────────────────────────────────
# Envoi des e-mails (Resend). Absent : le build passe, les envois échouent.
RESEND_API_KEY=re_your_resend_api_key

# Assistant conversationnel. Absent : le widget répond « n'est pas configuré ».
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Site ─────────────────────────────────────────────────────────────────────
# Domaine canonique : métadonnées, URL canoniques, sitemap et robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.cercle-administrateurs.sn

# Google Tag Manager. Le marqueur ne se charge pas en développement.
NEXT_PUBLIC_GTM_ID=GTM-PJL7FMWF
